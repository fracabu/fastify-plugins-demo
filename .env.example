# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# API Key Authentication (@fracabu/fastify-api-key)
API_KEY_MASTER=your-master-api-key-here
API_KEY_READ_ONLY=your-read-only-key-here

# Webhook Verification (fastify-webhook-verify)
WEBHOOK_SECRET_GITHUB=whsec_github_secret_here
WEBHOOK_SECRET_STRIPE=whsec_stripe_secret_here

# i18n Configuration (fastify-i18n-plugin)
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,it,es

# Cache Configuration (fastify-cache-control)
CACHE_DEFAULT_MAX_AGE=3600
